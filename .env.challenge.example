# ─── Challenge System (add these to .env.local) ───────────────────────────────

# HMAC secret — shared between Next.js API and process-score-event edge function
# Generate: openssl rand -hex 32
SCORE_EVENT_SECRET=your_score_event_secret_here

# Firebase Cloud Messaging — push notifications
FCM_SERVER_KEY=your_fcm_server_key_here

# Twilio — SMS for Library Card holders (war_declared, winner_declared, battle_boost)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ─── Supabase Edge Function env vars (set in Supabase dashboard → Edge Functions → Secrets) ──
# SUPABASE_URL              (auto-injected by Supabase runtime)
# SUPABASE_SERVICE_ROLE_KEY (auto-injected by Supabase runtime)
# SCORE_EVENT_SECRET        (add manually)
# FCM_SERVER_KEY            (add manually)
# TWILIO_ACCOUNT_SID        (add manually)
# TWILIO_AUTH_TOKEN         (add manually)
# TWILIO_FROM_NUMBER        (add manually)
# NEXT_PUBLIC_APP_URL       (add manually)
